<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude location preferences from both transfer mechanisms. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="clockbrief_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="clockbrief_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
